var AIExecutionRetryManager = Class.create();
AIExecutionRetryManager.prototype = {
initialize: function() {
},

retryFailedExecution: function(executionSysId) {

var result = {
success: false,
message: ''
};

// Find failed execution
var execution = new GlideRecord(
'x_78515_globalte_0_ai_execution'
);

if (!execution.get(executionSysId)) {
result.message = 'Execution not found.';
return result;
}

if (execution.getValue('execution_status') != 'failed') {
result.message = 'Execution is not in Failed status.';
return result;
}

// Get associated AI Agent
var agent = execution.ai_agent.getRefRecord();

if (!agent.isValidRecord()) {
result.message = 'AI Agent not found.';
return result;
}

var maxAttempts = parseInt(
agent.getValue('maximum_attempts'), 10
);

if (isNaN(maxAttempts) || maxAttempts < 0) {
result.message = 'Invalid maximum attempts configuration.';
return result;
}

var retryCount = parseInt(
execution.getValue('retry_count'), 10
) || 0;

// Check retry limit
if (retryCount >= maxAttempts) {
result.message = 'Maximum retry attempts reached.';
return result;
}

// Store execution details
var executionId = execution.getUniqueValue();
var oldRetryCount = retryCount;

// Increment retry count and requeue
retryCount++;

execution.setValue('retry_count', retryCount);
execution.setValue('execution_status', 'queued');
execution.setValue('start_time', '');
execution.setValue('end_time', '');
execution.update();

// Create retry audit log
var auditDetails = {
executionId: executionId,
agentName: agent.getValue('agent_name'),
actionType: 'retry_attempt',
targetTable: 'x_78515_globalte_0_ai_execution',
targetRecord: executionId,
beforeValue: 'failed; retry_count=' + oldRetryCount,
afterValue: 'queued; retry_count=' + retryCount,
result: 'success'
};

var auditResult =
new AIAuditService().logAction(auditDetails);

// Automatically dispatch execution
var dispatchResult =
new AIExecutionDispatcher().dispatchExecution(
executionId
);

result.success = true;
result.retryCount = retryCount;
result.maximumAttempts = maxAttempts;
result.auditCreated = auditResult &&
auditResult.success === true;
result.dispatchResult = dispatchResult;

if (!dispatchResult || dispatchResult.success !== true) {
result.message =
'Retry queued and audit attempted, but dispatch failed.';
return result;
}

result.message =
'Retry successful. Execution dispatched automatically.';

return result;
},

type: 'AIExecutionRetryManager'
};









